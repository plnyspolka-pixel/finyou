          ],
          "pattern": "^\\d{10}$"
        },
        "regon": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{9}(\\d{5})?$"
        },
        "dokument_tozsamosci": {
          "type": [
            "string",
            "null"
          ],
          "description": "np. 'dowód osobisty nr ABC123456'"
        },
        "adres": {
          "type": "string",
          "minLength": 5
        },
        "telefon": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "stan_cywilny": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "kawaler_panna",
            "zonaty_zamezna",
            "rozwiedziony",
            "wdowiec",
            null
          ],
          "description": "Istotne dla wymogu zgody małżonka (art. 37 k.r.o.)"
        },
        "ustroj_majatkowy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "wspolnosc_ustawowa",
            "rozdzielnosc",
            "wspolnosc_umowna",
            null
          ]
        },
        "zakres_odpowiedzialnosci": {
          "type": "string",
          "enum": [
            "rzeczowa",
            "rzeczowa_i_osobista"
          ],
          "default": "rzeczowa_i_osobista",
          "description": "'rzeczowa' = wyłącznie z nieruchomości (dłużnik rzeczowy, bez poręczenia z art. 876 k.c.). 'rzeczowa_i_osobista' = hipoteka + poręczenie osobiste."
        },
        "zgoda_malzonka": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "description": "Wypełnić, gdy poręczyciel pozostaje we wspólności ustawowej. Zgoda na hipotekę (art. 37 k.r.o.) i na poręczenie (art. 41 k.r.o.) to DWIE ODRĘBNE czynności.",
          "additionalProperties": false,
          "required": [
            "na_hipoteke",
            "na_poreczenie"
          ],
          "properties": {
            "na_hipoteke": {
              "type": "boolean",
              "description": "Zgoda na hipotekę (art. 37 § 1 pkt 1 k.r.o.)"
            },
            "na_poreczenie": {
              "type": "boolean",
              "description": "Zgoda na poręczenie (art. 41 § 1 k.r.o.). Brak NIE unieważnia poręczenia — ogranicza egzekucję do majątku osobistego (art. 41 § 2 k.r.o.)."
            }
          }
        }
      }
    },
    "porecziciel_podmiot": {
      "type": "object",
      "required": [
        "typ",
        "nazwa",
        "adres"
      ],
      "additionalProperties": false,
