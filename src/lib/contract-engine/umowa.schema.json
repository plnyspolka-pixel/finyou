          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "reprezentacja": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/reprezentant"
              }
            },
            {
              "$ref": "#/$defs/reprezentant"
            },
            {
