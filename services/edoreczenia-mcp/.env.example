# Wprowadź w menedżerze sekretów / zmiennych środowiskowych. NIGDY w git.
EDO_ENV=int
EDO_ENABLE_LIVE_SEND=NO
EDO_ALLOW_PERSONAL=NO
EDO_ALLOWED_MAILBOXES=financeyou,fundacja
EDO_STATE_DIR=
# W konfiguracji system oznacza nazwę systemu zarejestrowanego w e-Doręczeniach.
# Nie wpisuj prawdziwych ADE do repozytorium publicznego.
EDO_BOXES_JSON=[{"id":"financeyou","label":"Finance You sp. z o.o.","ade":"AE:PL-...","mode":"system","system":"FINANCEYOU","keyEnv":"EDO_FINANCEYOU_PRIVATE_KEY"},{"id":"fundacja","label":"Fundacja","ade":"AE:PL-...","mode":"system","system":"FUNDACJA","keyEnv":"EDO_FUNDACJA_PRIVATE_KEY"},{"id":"personal","label":"Skrzynka osobista","ade":"AE:PL-...","mode":"delegated_token","tokenEnv":"EDO_PERSONAL_ACCESS_TOKEN"}]
# PEM certyfikatu nie musi być sekretem, ale KLUCZ PRYWATNY tak.
# EDO_FINANCEYOU_PRIVATE_KEY="<PEM in secret manager>"
# EDO_FUNDACJA_PRIVATE_KEY="<PEM in secret manager>"
# Token osobisty: tymczasowa integracja delegowana, wymaga zgodności z kanałem operatora.
# EDO_PERSONAL_ACCESS_TOKEN="<short lived token>"
